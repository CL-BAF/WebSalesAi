# WebSalesAi configuration example.
# Copy to .env and adjust. NEVER commit your real .env.
# Values marked [SECRET] must never be shared or committed.

# --- Application -------------------------------------------------------------
NODE_ENV=development                # development | test | production
PORT=3000
DATABASE_PATH=./data/websalesai.sqlite
LOG_LEVEL=info                      # fatal | error | warn | info | debug | trace
PUBLIC_BASE_URL=http://localhost:3000

# --- Secrets (all required outside NODE_ENV=test) ----------------------------
DASHBOARD_PASSWORD=change-me-dashboard-password   # [SECRET] dashboard login
SESSION_SECRET=change-me-long-random-string       # [SECRET] session signing

# --- Ollama / AI ---------------------------------------------------------------
# Ollama Cloud: https://ollama.com  (set OLLAMA_API_KEY)
# Local Ollama:  http://localhost:11434 (no key needed)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=                                    # [SECRET] Ollama Cloud API key
OLLAMA_MODEL=glm-5.3-flash
# Optional per-role overrides (fall back to OLLAMA_MODEL):
#OLLAMA_MODEL_RESEARCHER=glm-5.3-flash
#OLLAMA_MODEL_SALES=glm-5.3-flash
#OLLAMA_MODEL_BUILDER=glm-5.3-flash
#OLLAMA_MODEL_REVIEWER=glm-5.3-flash
OLLAMA_TIMEOUT_MS=120000
OLLAMA_MAX_REPAIR_RETRIES=2      # bounded repair attempts for invalid AI JSON
OLLAMA_TRANSPORT_RETRIES=2       # bounded transport retries (timeouts, 429, 5xx)

# --- Review / QA loop ----------------------------------------------------------
REVIEW_MAX_CYCLES=5              # Builder/Reviewer cycles before NEEDS_HUMAN_REVIEW
REQUIRE_PAYMENT_FOR_PRODUCTION=true   # FAIL-CLOSED. Set false ONLY if you accept
                                 # deploying production sites without confirmed
                                 # payment (owner-authorized override).

# --- Providers -----------------------------------------------------------------
# Mock providers are the safe default. Real providers require their
# credentials (boot fails closed without them) AND the master readiness gate:
PRODUCTION_EXTERNAL_ACTIONS_ENABLED=false
# ^ Default false. When false, real providers are ignored and mocks are used
#   (loud warning at startup). true permits configured REAL providers to act;
#   approval gates, suppression, kill switch, payment checks and deployment
#   guards remain fully in force regardless.

EMAIL_PROVIDER=mock              # mock | resend
# RESEND_API_KEY=re_xxxxxxxx                     # [SECRET] (required for resend)
# RESEND_FROM=WebSalesAi <replies@yourdomain.com>  # verified sending identity
# RESEND_SENDER_DOMAIN=yourdomain.com            # for deterministic Message-IDs
# RESEND_WEBHOOK_SECRET=whsec_...                # [SECRET] svix webhook signing

PAYMENT_PROVIDER=mock            # mock | stripe
STRIPE_SECRET_KEY=               # [SECRET] sk_test_... / sk_live_... (prefix-validated)
STRIPE_WEBHOOK_SECRET=           # [SECRET] whsec_... (required for stripe)

DEPLOYMENT_PROVIDER=local        # local | cloudflare
CLOUDFLARE_API_TOKEN=            # [SECRET] Pages:Edit token (cloudflare mode)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=

# --- Outreach safety ------------------------------------------------------------
OUTREACH_ENABLED=false           # global outbound communication enable (opt-in!)
OUTREACH_REQUIRE_APPROVAL=true   # human approval before FIRST cold outreach
OUTREACH_MAX_PER_DAY=20
OUTREACH_MAX_PER_DOMAIN_PER_DAY=1
OUTREACH_COOLDOWN_HOURS=72       # per-contact cooldown
OUTREACH_MIN_SCORE=60            # minimum researcher score for auto-qualification
OUTREACH_KILL_SWITCH=false       # initial state; runtime toggle also available
AUTOMATION_PAUSED=false          # initial state; runtime toggle also available

# --- Payment / webhook secrets (optional in mock mode) ---------------------------
PAYMENT_WEBHOOK_SECRET=          # [SECRET] required to accept payment webhooks
INBOUND_EMAIL_WEBHOOK_SECRET=    # [SECRET] required to accept inbound email webhooks

# --- Filesystem layout ------------------------------------------------------------
WORKSPACES_ROOT=./workspaces     # isolated per-customer website workspaces
PREVIEWS_ROOT=./previews         # preview deployment output
PRODUCTION_DEPLOYS_ROOT=./production-deploys

# --- Pricing (deterministic; AI cannot alter) --------------------------------------
PRICING_CURRENCY=USD
PRICING_TIERS_JSON={"starter":49900,"business":89900,"premium":149900}  # cents

# --- Network safety ------------------------------------------------------------------
FETCH_TIMEOUT_MS=20000
FETCH_MAX_BYTES=2000000          # max bytes fetched from external websites
EXEC_TIMEOUT_MS=120000           # max runtime for allowlisted build commands
