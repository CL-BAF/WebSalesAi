{
  "name": "websalesai",
  "version": "0.1.0",
  "private": true,
  "description": "AI assisted website sales and delivery platform (Ollama Cloud powered, human-gated).",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pino": "^9.7.0",
    "stripe": "^22.6.0",
    "svix": "^2.1.0",
    "wrangler": "^4.127.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
